<VirtualHost *:80>
    ServerName {{ item.domain }}
    
    DocumentRoot {{ item.root }}
    
    # =========================================================================
    # CONFIGURAÇÃO DE DIRETÓRIO
    # =========================================================================
    <Directory {{ item.root }}>
        Options {% if item.spa is defined and item.spa %}-Indexes{% else %}+Indexes{% endif %} +FollowSymLinks
        AllowOverride All
        Require all granted
        
{% if item.spa is defined and item.spa %}
        # =====================================================================
        # REGRAS PARA SPA (SINGLE PAGE APPLICATION)
        # =====================================================================
        RewriteEngine On
        RewriteBase /
        
        # Não reescrever arquivos/diretórios existentes
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteCond %{REQUEST_FILENAME} !-d
        
        # Redirecionar tudo para index.html
        RewriteRule . /index.html [L]
{% endif %}
    </Directory>
    
    # =========================================================================
    # HEADERS DE SEGURANÇA
    # =========================================================================
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    ServerSignature Off
    
    # =========================================================================
    # CACHE E COMPRESSÃO
    # =========================================================================
    # Compressão GZIP
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
        AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
        AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
        AddOutputFilterByType DEFLATE image/svg+xml
    </IfModule>
    
    # Cache agressivo para assets estáticos
    <IfModule mod_expires.c>
        ExpiresActive On
        
        # Imagens
        ExpiresByType image/jpg "access plus 1 year"
        ExpiresByType image/jpeg "access plus 1 year"
        ExpiresByType image/gif "access plus 1 year"
        ExpiresByType image/png "access plus 1 year"
        ExpiresByType image/webp "access plus 1 year"
        ExpiresByType image/svg+xml "access plus 1 year"
        ExpiresByType image/x-icon "access plus 1 year"
        
        # CSS e JavaScript
        ExpiresByType text/css "access plus 1 month"
        ExpiresByType application/javascript "access plus 1 month"
        ExpiresByType application/x-javascript "access plus 1 month"
        
        # Fonts
        ExpiresByType font/ttf "access plus 1 year"
        ExpiresByType font/woff "access plus 1 year"
        ExpiresByType font/woff2 "access plus 1 year"
        ExpiresByType application/font-woff "access plus 1 year"
        ExpiresByType application/font-woff2 "access plus 1 year"
        
        # HTML não deve fazer cache
        ExpiresByType text/html "access plus 0 seconds"
    </IfModule>
    
    # Headers de cache para controle fino
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
    
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
    
    # =========================================================================
    # LOGS
    # =========================================================================
    ErrorLog ${APACHE_LOG_DIR}/{{ item.domain | replace('.', '-') }}_error.log
    CustomLog ${APACHE_LOG_DIR}/{{ item.domain | replace('.', '-') }}_access.log combined
    
    # Log com IP real do Cloudflare
    LogFormat "%a %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" cloudflare
    CustomLog ${APACHE_LOG_DIR}/{{ item.domain | replace('.', '-') }}_access.log cloudflare
</VirtualHost>
