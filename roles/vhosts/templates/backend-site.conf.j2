<VirtualHost *:80>
    ServerName {{ item.domain }}
    
    # Documentroot para servir arquivos estáticos se necessário
    DocumentRoot {{ item.root }}
    
    # Configuração de diretório principal
    <Directory {{ item.root }}>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
    
{% if item.extra_dirs is defined %}
{% for dir in item.extra_dirs %}
    # Diretório adicional: {{ dir }}
    <Directory {{ dir }}>
        Options -Indexes +FollowSymLinks
        AllowOverride None
        Require all granted
    </Directory>
    
{% endfor %}
{% endif %}
    # =========================================================================
    # PROXY REVERSO PARA APLICAÇÃO NODE.JS
    # =========================================================================
    ProxyPreserveHost On
    ProxyRequests Off
    
    # Timeout mais alto para requests longos
    ProxyTimeout 300
    
    # Proxy para a aplicação
    ProxyPass / http://127.0.0.1:{{ item.port }}/
    ProxyPassReverse / http://127.0.0.1:{{ item.port }}/
    
    # Suporte a WebSocket
    RewriteEngine On
    RewriteCond %{HTTP:Upgrade} websocket [NC]
    RewriteCond %{HTTP:Connection} upgrade [NC]
    RewriteRule ^/?(.*) ws://127.0.0.1:{{ item.port }}/$1 [P,L]
    
    # =========================================================================
    # HEADERS DE SEGURANÇA
    # =========================================================================
    # Proteção contra clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Prevenir MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Ativar proteção XSS do navegador
    Header always set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Remover informações do servidor
    Header always unset X-Powered-By
    ServerSignature Off
    
    # =========================================================================
    # CLOUDFLARE - RESTORE REAL IP
    # =========================================================================
    # O Cloudflare passa o IP real do visitante no header CF-Connecting-IP
    # Configurado via mod_remoteip no Apache
    
    # =========================================================================
    # CACHE E COMPRESSÃO
    # =========================================================================
    # Compressão de conteúdo
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
    </IfModule>
    
    # Cache de arquivos estáticos (se houver)
    <IfModule mod_expires.c>
        ExpiresActive On
        ExpiresByType image/jpg "access plus 1 year"
        ExpiresByType image/jpeg "access plus 1 year"
        ExpiresByType image/gif "access plus 1 year"
        ExpiresByType image/png "access plus 1 year"
        ExpiresByType image/webp "access plus 1 year"
        ExpiresByType text/css "access plus 1 month"
        ExpiresByType application/javascript "access plus 1 month"
        ExpiresByType application/x-javascript "access plus 1 month"
    </IfModule>
    
    # =========================================================================
    # LOGS
    # =========================================================================
    ErrorLog ${APACHE_LOG_DIR}/{{ item.domain | replace('.', '-') }}_error.log
    CustomLog ${APACHE_LOG_DIR}/{{ item.domain | replace('.', '-') }}_access.log combined
    
    # Log com IP real do Cloudflare
    LogFormat "%a %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" cloudflare
    CustomLog ${APACHE_LOG_DIR}/{{ item.domain | replace('.', '-') }}_access.log cloudflare
</VirtualHost>
