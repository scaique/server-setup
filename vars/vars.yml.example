---
# ==============================================================================
# EXEMPLO DE CONFIGURAÇÃO
# ==============================================================================
# Copie este arquivo para vars/vars.yml e ajuste conforme necessário
# ==============================================================================

# Email para certificados SSL e notificações
user_email: "seu@email.com"

# Versão do Node.js (major)
node_major: "22"

# Gerenciador de pacotes Node
pnpm_package: "pnpm@latest"

# ==============================================================================
# SEUS SITES
# ==============================================================================

sites:
  # Exemplo: Next.js application
  - domain: app.seusite.com.br
    type: backend
    root: /var/www/app
    port: 3000

  # Exemplo: NestJS API
  - domain: api.seusite.com.br
    type: backend
    root: /var/www/api
    port: 8000
    extra_dirs:
      - /var/www/api/uploads

  # Exemplo: Site estático (React build)
  - domain: www.seusite.com.br
    type: static
    root: /var/www/website/dist
    spa: true

# ==============================================================================
# SEGURANÇA
# ==============================================================================

fail2ban_config:
  bantime: 3600
  findtime: 600
  maxretry: 3
  destemail: "seu@email.com"

ufw_rules:
  - port: 22
    proto: tcp
    rule: allow
  - port: 80
    proto: tcp
    rule: allow
  - port: 443
    proto: tcp
    rule: allow

# ==============================================================================
# APACHE
# ==============================================================================

apache_modules:
  - proxy
  - proxy_http
  - proxy_wstunnel
  - proxy_balancer
  - lbmethod_byrequests
  - rewrite
  - headers
  - ssl
  - expires
  - cache
  - cache_disk
  - deflate

# ==============================================================================
# CLOUDFLARE - IPs atualizados em Dezembro 2025
# ==============================================================================

cloudflare_ipv4:
